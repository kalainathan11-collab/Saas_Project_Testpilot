# Copy to .env.production on the server and fill in. deploy/deploy.sh generates the secrets
# for you the first time it runs. NEVER commit .env.production.
DOMAIN=solarsbs.sbs
POSTGRES_USER=testpilot
POSTGRES_DB=testpilot
POSTGRES_PASSWORD=
SECRET_KEY=
# Optional: Google sign-in (redirect URI https://<DOMAIN>/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
