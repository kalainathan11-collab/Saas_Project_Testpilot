# Copy to .env and replace every placeholder. Never commit .env.

# --- PostgreSQL (used by the db container; compose builds DATABASE_URL from these) ---
POSTGRES_USER=testpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=testpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
# Local dev (backend run outside Docker): host is localhost.
# Under docker compose the backend container uses host `db` instead
# (postgresql+psycopg://USER:PASS@db:5432/DB) - compose builds this itself, so no change needed here.
DATABASE_URL=postgresql+psycopg://testpilot:change-me@localhost:5432/testpilot
# Required: >= 32 random chars (python -c "import secrets; print(secrets.token_urlsafe(48))").
# Placeholder-looking values (change-me, your-secret, secret-key...) are rejected at startup.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Where the backend redirects after Google sign-in (tokens sent in the URL fragment).
# docker compose serves the frontend at http://localhost:3000 (the value below).
# The Vite dev server (npm run dev) uses http://localhost:5173 - set FRONTEND_URL to that for local dev.
# Use https in production (Secure cookie).
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed origins (compose frontend on 3000, Vite dev server on 5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend (build-time) ---
# Baked into the bundle; also used as the API origin in the nginx Content-Security-Policy.
VITE_API_URL=http://localhost:8000

# --- Docker compose published-port bind address ---
# 127.0.0.1 keeps backend/frontend reachable only from this machine. Set 0.0.0.0 to expose them.
BIND_ADDRESS=127.0.0.1
